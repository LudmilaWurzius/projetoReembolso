        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue === '') {
        return;
    }
    var today = new Date();
    today.setHours(0, 0, 0, 0); 
    today = new Date(today.getTime() - (3 * 60 * 60 * 1000));

    
    var todayString = today.toISOString().split('T')[0]; 

    var dateParts = newValue.split('/');
    var selectedDate = new Date(dateParts[2], dateParts[1] - 1, dateParts[0]);
    selectedDate.setHours(0, 0, 0, 0); 

    if (selectedDate >= today) {
        g_form.addErrorMessage("You cannot insert a record with the current or future date! Please select a valid date.");
        g_form.setValue("expense_date", ""); 
    } else {
        g_form.clearMessages(); 
    }
}
]]></script>
