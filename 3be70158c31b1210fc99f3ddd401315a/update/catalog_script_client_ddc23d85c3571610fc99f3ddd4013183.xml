        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    // Ignorar validação ao carregar o formulário ou se o valor estiver vazio
    if (isLoading || newValue === '') {
        return;
    }

    // Substituir vírgula por ponto
    var valorConvertido = newValue.replace(',', '.');

    // Validar se o valor convertido é numérico
    if (!isNaN(valorConvertido)) {
        // Atualizar o campo com o valor corrigido, formatado para 2 casas decimais
        g_form.setValue(control.name, parseFloat(valorConvertido).toFixed(2));
    } else {
        // Mostrar mensagem de erro se o valor não for numérico
        g_form.showFieldMsg(control.name, 'Por favor, insira um valor numérico válido.', 'error');
    }
}

